# Stage 1: Node.js builder
FROM node:lts-alpine3.23 AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY src/static ./src/static

# The roche_ca secret is optional (required=false): outside the Roche network the
# mount is absent and this builds exactly like upstream. Inside it, the corporate
# TLS-interception CA has to be trusted or npm cannot reach the registry.
RUN --mount=type=secret,id=roche_ca,target=/tmp/roche-ca.crt,required=false \
    if [ -s /tmp/roche-ca.crt ]; then \
        cat /tmp/roche-ca.crt >> /etc/ssl/certs/ca-certificates.crt; \
        export NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt; \
    fi \
    && npm ci --no-audit --no-fund \
    && export PATH=./node_modules/.bin:$PATH \
    && npm run build-stylus \
    && npm run build-riot \
    && npm run concat-riot

# Stage 2: Python/Django
FROM almalinux:10-minimal

# Same optional Roche CA injection, for microdnf and for the uv installer below.
RUN --mount=type=secret,id=roche_ca,target=/tmp/roche-ca.crt,required=false \
    if [ -s /tmp/roche-ca.crt ]; then \
        cp /tmp/roche-ca.crt /etc/pki/ca-trust/source/anchors/roche-ca.crt \
        && update-ca-trust 2>/dev/null \
        || cat /tmp/roche-ca.crt >> /etc/pki/tls/certs/ca-bundle.crt; \
    fi \
    && microdnf update -y --nodocs && microdnf install -y tar gzip &&  microdnf clean all

ENV PYTHONUNBUFFERED=1

# Install UV and add paths to PATH for uv and the future .venv created by uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && microdnf remove -y tar gzip && microdnf clean all
ENV PATH=$PATH:/root/.local/bin
ENV PATH=$PATH:/.venv/bin

# Copy pyproject and uv.lock
COPY pyproject.toml uv.lock ./

# Install dependencies
RUN uv sync --all-extras --frozen

WORKDIR /app

COPY src ./src
COPY manage.py ./

# Copy built static files from Node builder
COPY --from=builder /app/src/static ./src/static

ENTRYPOINT ["/bin/bash", "-c"]