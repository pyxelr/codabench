FROM almalinux:10-minimal AS builder

# The roche_ca secret is optional (required=false): outside the Roche network the
# mount is absent and this builds exactly like upstream. Inside it, the corporate
# TLS-interception CA has to be trusted or microdnf cannot reach the mirrors.
# The anchor file is written into the layer, so the trust survives into the
# squashed stage below and is still present for the uv installer.
RUN --mount=type=secret,id=roche_ca,target=/tmp/roche-ca.crt,required=false \
    if [ -s /tmp/roche-ca.crt ]; then \
        cp /tmp/roche-ca.crt /etc/pki/ca-trust/source/anchors/roche-ca.crt \
        && update-ca-trust 2>/dev/null \
        || cat /tmp/roche-ca.crt >> /etc/pki/tls/certs/ca-bundle.crt; \
    fi \
    && microdnf update -y --nodocs && microdnf install -y tar gzip &&  microdnf clean all

FROM scratch

COPY --from=builder / /

# This makes output not buffer and return immediately, nice for seeing results in stdout
ENV PYTHONUNBUFFERED=1

COPY compute_worker/pyproject.toml compute_worker/uv.lock compute_worker/celery_config.py compute_worker/compute_worker.py ./

# Install UV and add paths to PATH for uv and the future .venv created by uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && microdnf remove -y tar gzip && microdnf clean all
ENV PATH=$PATH:/root/.local/bin
ENV PATH=$PATH:/.venv/bin


# Install dependencies
RUN uv sync --frozen
COPY src/settings/logs_loguru.py /.venv/bin

ENTRYPOINT ["/bin/bash", "-c"]
CMD ["celery -A compute_worker worker -l info -Q compute-worker -n compute-worker@$HOSTNAME --concurrency=1"]
